{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // Monochrome: everything in the terminal's ink color (color0)
  "logo": { "color": { "1": "black", "2": "black", "3": "black", "4": "black", "5": "black", "6": "black" } },
  "display": { "color": { "keys": "black", "title": "black", "output": "default" }, "separator": "  " },
  "modules": [
    "title", "separator",
    "os", "host", "kernel", "uptime", "packages", "shell",
    "display", "de", "wm", "theme", "font", "terminal", "terminalfont",
    "cpu", "gpu", "memory", "disk", "locale"
  ]
}
