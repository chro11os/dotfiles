{
  "layer": "top",
  "position": "top",
  "height": 30,
  "modules-left": ["custom/power"],
  "modules-right": ["custom/settings", "clock"],

  // Apple-menu spot: click for a dropdown
  "custom/power": {
    "format": "\uf011",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "~/.config/waybar/power_menu.xml",
    "menu-actions": {
      "sleep": "systemctl suspend",
      "restart": "systemctl reboot",
      "shutdown": "systemctl poweroff",
      "logout": "hyprctl dispatch exit"
    }
  },

  // gnome-control-center refuses to start unless it thinks it's on GNOME
  "custom/settings": {
    "format": "\uf013",
    "tooltip": false,
    "on-click": "env XDG_CURRENT_DESKTOP=GNOME gnome-control-center"
  },

  "clock": {
    "format": "{:%a %b %d  %I:%M %p}",
    "tooltip-format": "<tt>{calendar}</tt>"
  }
}
